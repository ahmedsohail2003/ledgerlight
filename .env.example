# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ledgerlight
DB_PASSWORD=change_me
DB_NAME=ledgerlight

# Least-privilege DB identities (created by server/src/db/grants.sql):
# ro = SELECT-only pool used by the agent's evidence read path;
# admin = DDL for migrations and the ETL reset.
DB_RO_USER=ledgerlight_ro
DB_RO_PASSWORD=change_me
DB_ADMIN_USER=ledgerlight_admin
DB_ADMIN_PASSWORD=change_me

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Gemini API key for the investigator agent (never committed). Without it, the
# app runs in deterministic-fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Official dataset (download from open.canada.ca; ~600MB, gitignored)
OFFICIAL_CSV_PATH=data/raw/contracts.csv
