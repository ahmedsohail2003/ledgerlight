# Copy to .env and adjust. Never commit .env.
#
# The passwords below are the DEV DEFAULTS the grants bootstrap creates
# (server/src/db/grants.sql, auto-applied on first `docker compose up`), so a
# fresh clone works without editing. They are placeholders for LOCAL use over
# public data only — for anything else, change them in MySQL (ALTER USER) and
# here together.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ledgerlight
DB_PASSWORD=ledgerlight_dev
DB_NAME=ledgerlight

# Least-privilege DB identities (created by server/src/db/grants.sql):
# ro = SELECT-only pool used by the agent's evidence read path (REQUIRED —
#      the pool fails closed without it; ALLOW_SINGLE_DB_IDENTITY=1 is the
#      loudly-logged demo escape hatch);
# admin = DDL for migrations and the ETL reset.
DB_RO_USER=ledgerlight_ro
DB_RO_PASSWORD=ro_dev_change_me
DB_ADMIN_USER=ledgerlight_admin
DB_ADMIN_PASSWORD=admin_dev_change_me

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Demo users created by `npm run seed:users`. Leave empty to have strong
# random passwords generated and printed once at seed time.
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# Gemini API key for the investigator agent (never committed). Without it, the
# app runs in deterministic-fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Official dataset (download from open.canada.ca; ~600MB, gitignored).
# Relative paths resolve against the repo root.
OFFICIAL_CSV_PATH=data/raw/contracts.csv
